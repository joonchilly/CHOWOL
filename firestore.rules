rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && myEmail() == "moonredcok@gmail.com"; }
    function allowed() { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/allow/$(myEmail()))); }

    // 초대 명단: 방장만 고칠 수 있고, 각자 자기 이메일이 있는지만 확인 가능
    match /allow/{email} {
      allow read: if isOwner() || (signedIn() && myEmail() == email);
      allow write: if isOwner();
    }
    // 앱 꾸미기 설정: 모두 읽고 방장만 바꿈
    match /config/{id} {
      allow read: if allowed();
      allow write: if isOwner();
    }
    // 프로필: 모두 읽고 자기 것만 바꿈
    match /members/{uid} {
      allow read: if allowed();
      allow write: if allowed() && request.auth.uid == uid;
    }
    // 1:1 메시지: 대화 당사자 두 명만 읽음
    match /dm/{id} {
      allow read: if allowed() && request.auth.uid in resource.data.members;
      allow create: if allowed() && request.auth.uid in request.resource.data.members && request.resource.data.author == request.auth.uid;
      allow delete: if allowed() && (resource.data.author == request.auth.uid || isOwner());
    }
    // 게시물·댓글·단체방: 초대받은 사람 모두
    match /posts/{id} { allow read, write: if allowed(); }
    match /comments/{id} { allow read, write: if allowed(); }
    match /chat/{id} { allow read, write: if allowed(); }
    // 사우나 기록(랭킹용)과 애프터 사우나 맛집
    match /sauna/{id} { allow read, write: if allowed(); }
    match /eats/{id} { allow read, write: if allowed(); }
    // 푸시 알림 받을 휴대폰 주소: 본인 것만 등록·삭제, 읽기는 서버만
    match /pushTokens/{token} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // 운동 인증(크루 바디용)
    match /workouts/{id} {
      allow read, write: if allowed();
    }
    // 러닝 거리(크루 누적용)
    match /runs/{id} { allow read, write: if allowed(); }
    // 단체방 공지
    match /notices/{id} { allow read, write: if allowed(); }
    // 채팅 사진·동영상 (조각으로 나눠 저장)
    match /media/{id} { allow read, write: if allowed(); }
    match /media/{id}/c/{part} { allow read, write: if allowed(); }
  }
}
